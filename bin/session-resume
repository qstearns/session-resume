#!/bin/sh
# session-resume is lib/session-resume.lua, run by Rex's own Lua. This only
# adapts the command line: `rex do` takes KEY=VALUE arguments and reads values
# that look like JSON as JSON, so each argument goes through as argN=:VALUE.
set -eu
self=$(readlink -f "$0")
lua="${self%/bin/*}/lib/session-resume.lua"
export REX_AUTOSTART=false # never start a server just to record or restore

case "${1:-}" in
autostart) # launched by init.lua while the server is still coming up
	i=0
	until rex server status >/dev/null 2>&1; do
		i=$((i + 1)) && [ "$i" -lt 30 ] && sleep 1 || exit 1
	done
	;;
esac

hook=${1:-}
n=0
for a; do shift; n=$((n + 1)); set -- "$@" "arg$n=:$a"; done
if [ "$hook" = hook ]; then # a hook must never get in the agent's way
	rex do "$lua" pid=$$ shim=":$self" "$@" 2>/dev/null || true
	exit 0
fi
exec rex do "$lua" pid=$$ shim=":$self" "$@"
